{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mobius-cloud-local",
  "main": "cloud/src/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "staging": {
      "name": "mobius-cloud-staging",
      "vars": {}
    },
    "production": {
      "name": "mobius-cloud-production",
      "vars": {}
    }
  },
  "account_id": "95af7a3d67be8c49b1619544e3ce53c0"
}
