{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "lib": ["es2024", "dom", "dom.iterable"]
  },
  "include": [
    "**/*.ts",
    "../scripts/**/*.ts",
    "../cloud/src/**/*.ts",
    "../vitest.config.ts",
    "../worker-configuration.d.ts",
    "../cloud/shared/**/*.ts",
    "../vite.config.ts",
    "**/*.tsx",
    "../vitest.browser.config.ts",
    "../cloud/web/**/*.ts",
    "../cloud/web/**/*.tsx"
  ]
}
